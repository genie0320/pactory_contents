# LLM API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=

# Studio Security (Auth Gate)
STUDIO_PASSWORD=your_secure_password_here

# Langfuse Observability & Prompt Tracing (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Pipeline Defaults
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_THINKING_LEVEL=low
LLM_CONCURRENCY=5

# Per-Task Granular AI Models (Indexing / Synthesis / Proofreading)
EXTRACTION_MODEL=gemini-3.5-flash-lite
EXTRACTION_THINKING_LEVEL=low
SYNTHESIS_MODEL=gemini-3.8-flash
SYNTHESIS_THINKING_LEVEL=medium
PROOFREADING_MODEL=gemini-3.8-pro
PROOFREADING_THINKING_LEVEL=high

# Data Paths
DATA_DIR=./data
CATALOG_DB_PATH=./data/index/catalog.db

