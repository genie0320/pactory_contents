[Unit]
Description=Pactory Studio FastAPI + React Application
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/pactory_contents
EnvironmentFile=%h/pactory_contents/.env
Environment="PATH=%h/pactory_contents/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=%h/pactory_contents"
ExecStart=%h/pactory_contents/.venv/bin/uvicorn src.api.main:app --host 0.0.0.0 --port 8501
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
